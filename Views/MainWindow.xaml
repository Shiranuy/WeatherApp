<Window x:Class="WeatherApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherApp"
        xmlns:vm="clr-namespace:WeatherApp.ViewModels"
        xmlns:conv="clr-namespace:WeatherApp.Converters"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Погодное приложение" 
        Height="464" 
        Width="900"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:BoolToFavoriteTextConverter x:Key="BoolToFavoriteTextConverter"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ForecastDayStyle" TargetType="Border">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Width" Value="100"/>
        </Style>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
        
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
    </Window.Resources>


    <Grid Background="#87CEEB">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <Border Style="{StaticResource CardStyle}" Background="#d1f2ff">
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Width="472"
                             Background="#d1f2ff"
                             FontSize="16"
                             Padding="5"
                             VerticalContentAlignment="Center"
                             BorderThickness="0"/>
                    <Button Content="Поиск"
                            Command="{Binding LoadWeatherCommand}"
                            Padding="10 5"
                            FontSize="14"
                            Background="#1976d2"
                            Foreground="White"
                            BorderThickness="0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Background="#d1f2ff"
                    Visibility="{Binding CurrentWeather, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding CurrentWeather.City}"
                                   FontSize="22"
                                   FontWeight="Bold"/>

                        <Button Grid.Column="1"
                                Content="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteTextConverter}}"
                                Command="{Binding ToggleFavoriteCommand}"
                                Margin="10 0 0 0"
                                Padding="5"
                                Background="Transparent"
                                BorderThickness="0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0 10">
                        <Image Source="{Binding CurrentWeather.Icon}"
                               Width="60"
                               Height="60"
                               Margin="0 0 10 0"/>

                        <TextBlock Text="{Binding CurrentWeather.Temperature, StringFormat={}{0}°C}"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding CurrentWeather.Description}"
                               FontSize="16"/>


                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0 10 0 0" Background="#d1f2ff"
                    Visibility="{Binding Forecast, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Прогноз на 5 дней" 
                               FontWeight="Bold"
                               Margin="0 0 5 5"/>

                    
                        <ItemsControl ItemsSource="{Binding Forecast.Daily}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ForecastDayStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Date, StringFormat='ddd dd/MM'}" 
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <Image Source="{Binding Icon}"
                                                   Width="40"
                                                   Height="40"
                                                   HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding DayTemperature, StringFormat={}{0}°C}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Description}"
                                                       HorizontalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    
                </StackPanel>
            </Border>


        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <Border Style="{StaticResource CardStyle}" Background="#d1f2ff">
                <StackPanel>
                    <TextBlock Text="Избранные города" 
                               FontWeight="Bold"
                               Margin="0 0 0 5"/>

                    <ListBox ItemsSource="{Binding FavoriteCities}"
                             SelectedItem="{Binding SearchQuery}"
                             BorderThickness="0"
                             Background="#d1f2ff">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding LoadWeatherCommand}"
                                                      CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" 
                                           Padding="5"
                                           Cursor="Hand"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0 10 0 0" Background="#d1f2ff">
                <StackPanel>
                    <TextBlock Text="История запросов" 
                               FontWeight="Bold"
                               Margin="0 0 0 5"/>

                    <ListView ItemsSource="{Binding WeatherHistory}"
                              BorderThickness="0"
                              MaxHeight="150"
                              Background="#d1f2ff">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5" Background="#d1f2ff">
                                    <TextBlock Text="{Binding City}" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Temperature, StringFormat={}{0}°C}"/>
                                        <TextBlock Text="{Binding RequestTime, StringFormat='{}{0:g}'}"
                                                   Margin="10 0 0 0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>